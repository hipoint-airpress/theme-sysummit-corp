<!DOCTYPE html>
<html lang="zh">
<head>
    {% include "www/module/head" with title=printf("%s - %s", "标签", blog_title) %}
</head>
<body>
{% include "www/module/header" %}
{% include "www/module/breadcrumb" with current="标签" %}

<div class="ap-page">
    <div class="ap-container">
        <h1 class="ap-page__title">标签</h1>
        <div class="ap-page__meta"><span>共 {{ getTagCount }} 个标签</span></div>
        <div class="ap-tags" style="margin-top:24px">
            {% set tags = getAllTag %}
            {% if tags %}
                {% for tag in tags %}
                    <a class="ap-tag" href="{{ tag.FullPath }}" title="{{ tag.Name }}">#{{ tag.Name }}（{{ tag.PostCount }}）</a>
                {% endfor %}
            {% else %}
                <div class="ap-empty">暂无标签</div>
            {% endif %}
        </div>
    </div>
</div>

{% include "www/module/footer" %}
{% include "www/module/scripts" %}
</body>
</html>
