{# 悬浮联系弹层：电话/邮箱读取主题设置的 JSON 数组，与联系页共用一份配置 #}
{% set contactPhones = from_json(settings.contact_phones) %}
{% set contactEmails = from_json(settings.contact_emails) %}
<div class="ap-contact-trigger" id="apContactTrigger" aria-label="联系方式">
    {% include "www/module/icon" with name="phone" %}
</div>
<div class="ap-contact-popup" id="apContactPopup">
    <div class="ap-contact-popup__head">
        <button type="button" id="apContactClose" aria-label="关闭">&times;</button>
    </div>
    <div class="ap-contact-popup__body">
        {% if contactPhones %}
            <div class="ap-contact-item">
                <div class="ap-contact-label">联系电话</div>
                {% for p in contactPhones %}
                    <a class="ap-contact-value" href="tel:{{ p.tel|default:p.value }}">{{ p.value }}</a>
                {% endfor %}
            </div>
        {% endif %}
        {% if contactEmails %}
            <div class="ap-contact-item">
                <div class="ap-contact-label">联系邮箱</div>
                {% for e in contactEmails %}
                    <span class="ap-contact-value" data-copy="{{ e.value }}">{{ e.value }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<div class="ap-float">
    <button class="ap-float__btn" id="apBackTop" type="button" aria-label="回到顶部">
        {% include "www/module/icon" with name="arrow-up" %}
    </button>
</div>
{% if settings.statistics|default:"true" != "false" %}
    {% include "common/macro/statistics" %}
{% endif %}
